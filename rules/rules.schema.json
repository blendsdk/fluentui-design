{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluentui-design/schemas/rules.schema.json",
  "title": "Operational rules catalog",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/rule" },
  "$defs": {
    "verifiedMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package", "version", "exports"],
      "properties": {
        "kind": { "const": "verified" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "exports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "applicationOwnedMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "note"],
      "properties": {
        "kind": { "const": "application-owned" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "wouldChangeIf"],
      "properties": {
        "level": { "enum": ["High", "Med", "Low"] },
        "wouldChangeIf": { "type": "string", "minLength": 1 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "decision",
        "decisionArea",
        "classification",
        "strength",
        "appliesWhen",
        "exceptions",
        "notApplicableWhen",
        "instruction",
        "rationale",
        "componentMapping",
        "layoutConsequences",
        "responsiveConsequences",
        "accessibilityImplications",
        "stateImplications",
        "evidenceSourceIds",
        "locators",
        "derivedFromFindings",
        "confidence",
        "unresolved",
        "positiveExample",
        "antiPattern",
        "verificationMethod",
        "relatedRules",
        "supersedes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RULE-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "decisionArea": {
          "enum": [
            "app-shell",
            "page-chrome",
            "forms",
            "overlays",
            "data-grid",
            "disclosure",
            "feedback",
            "theming",
            "accessibility",
            "responsive",
            "composition",
            "task-flows"
          ]
        },
        "classification": {
          "enum": ["requirement", "recommendation", "convention", "observation"]
        },
        "strength": { "enum": ["must", "should", "may"] },
        "appliesWhen": { "type": "string", "minLength": 1 },
        "exceptions": { "type": "string" },
        "notApplicableWhen": { "type": "string" },
        "instruction": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "componentMapping": {
          "oneOf": [
            { "$ref": "#/$defs/verifiedMapping" },
            { "$ref": "#/$defs/applicationOwnedMapping" }
          ]
        },
        "layoutConsequences": { "type": "string", "minLength": 1 },
        "responsiveConsequences": { "type": "string", "minLength": 1 },
        "accessibilityImplications": { "type": "string", "minLength": 1 },
        "stateImplications": { "type": "string", "minLength": 1 },
        "evidenceSourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^SRC-\\d{3}$" }
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "derivedFromFindings": {
          "type": "array",
          "items": { "type": "string", "pattern": "^FND-\\d{3}$" }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "unresolved": { "type": "string" },
        "positiveExample": { "type": "string" },
        "antiPattern": { "type": "string" },
        "verificationMethod": { "type": "string", "minLength": 1 },
        "relatedRules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RULE-\\d{3}$" }
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RULE-\\d{3}$" }
        }
      }
    }
  }
}
