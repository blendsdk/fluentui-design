{
  "name": "fluentui-design",
  "version": "0.1.1",
  "type": "module",
  "description": "Evidence-backed Agent Skill for composing web applications with Fluent UI React v9",
  "license": "MIT",
  "keywords": [
    "fluentui",
    "react",
    "agent-skill",
    "design-system",
    "accessibility"
  ],
  "homepage": "https://github.com/blendsdk/fluentui-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/fluentui-design.git"
  },
  "bugs": {
    "url": "https://github.com/blendsdk/fluentui-design/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fluentui-design": "dist/bin.js"
  },
  "files": [
    "dist/",
    "skills/fluentui-design/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "extract-facts": "tsx scripts/extract-facts.ts",
    "validate:sources": "tsx scripts/validate-sources.ts",
    "validate:rules": "tsx scripts/validate-rules.ts",
    "validate:all": "npm run validate:sources && npm run validate:rules",
    "lint:rules": "tsx scripts/lint-rules.ts",
    "check:facts": "tsx scripts/check-facts.ts",
    "check:version": "node scripts/check-version.mjs",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "check:refs": "tsx scripts/check-references.ts",
    "check:evaluation": "tsx scripts/evaluate.ts",
    "check:examples": "tsx scripts/check-examples.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "freshness": "tsx scripts/freshness.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "assemble": "tsx scripts/assemble.ts",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('skills',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build:cli && npm run assemble",
    "prepublishOnly": "npm run verify:static",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:static": "npm run typecheck && npm run lint && npm run test && npm run validate:all && npm run lint:rules && npm run check:facts && npm run check:version && npm run generate:check && npm run check:refs && npm run check:evaluation && npm run check:examples && npm run scan:secrets && npm run freshness -- --check",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run verify:static && npm run test:e2e"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "^2.0.341",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
